# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Monorepo: patterns are unanchored so they match in every app/package too.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js build output (per app)
.next/
out/

# production (static export lands here: distDir "build")
build/

# misc
.DS_Store
*.pem

# editors / IDEs
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
next-env.d.ts

# ship: per-branch review ledger + CI playbook — ephemeral, local, never committed
docs/ship-reviews/
docs/ship-playbook.md
